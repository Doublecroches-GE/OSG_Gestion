  procedures :
   -
     name : Rech_Personne
     procedure_id : 1747802645807855060
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // Rech_Personne ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure Rech_Personne()
      
      vs_recherche	est une chaine
      vn_nbLi			est un entier
      
      vs_recherche	= SAI_RechPersonne
      
      vn_nbLi			= ZR_Personnes..Occurrence
      POUR i = 1 A vn_nbLi
      	ZR_Personnes[i]..Visible = Contient(Majuscule(ZR_Personnes[i].ATT_Recherche), Majuscule(vs_recherche)) _OU_ vs_recherche = ""
      FIN
     type : 458752
   -
     name : Afficher_Liste
     procedure_id : 1749660068847436164
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // Afficher_Liste ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure réactive Afficher_Liste()
      
      sablier(vrai)
      SELON BS_Actifs
      	CAS 1 : gtab_Pers = Liste_PersonnesActives()
      	CAS 2 : gtab_Pers = Liste_PersonnesInactives()
      	CAS 3 : gtab_Pers = Liste_Personnes()
      	AUTRE CAS
      FIN
      ZR_Personnes.Affiche(taInit)
      sablier(faux)
     type : 458752
