 code_elements :
  type_code : 10
  p_codes :
   -
     code : |1-
      CL_Personne est une Classe <mapping=Personne><§rad:1§>
      	herite CL_Gestion<§rad:1§>
      	// Le code se trouvant entre <MAPPING> et <FIN> est généré automatiquement.<§rad:1§>
      	// Il sera effacé et recréé entièrement à chaque génération depuis le menu contextuel<§rad:1§>
      	// du fichier dans l'explorateur de projet ou dans l'analyse "..Regénérer la classe modèle"<§rad:1§>
      	<MAPPING><§rad:1§>
      	m_ID						est un entier sur 8 octets	<mapping=ID, clé unique><§rad:1§>
      	m_sNom						est une chaîne				<mapping=Nom>
      	m_sPrenom					est une chaîne				<mapping=Prenom>
      	m_sEMail						est une chaîne				<mapping=EMail>
      	m_sEmail_2					est une chaîne				<mapping=Email_2>
      	m_sTelephone					est une chaîne				<mapping=Telephone>
      	m_sAdresse					est une chaîne				<mapping=Adresse>
      	m_sAdr_Complement			est une chaîne				<mapping=Adr_Complement>
      	m_sNPA						est une chaîne				<mapping=NPA>
      	m_sLieu						est une chaîne				<mapping=Lieu>
      	m_sPays						est une chaîne				<mapping=Pays>
      	m_bPro						est un booléen				<mapping=Pro>
      	m_bHEM						est un booléen				<mapping=HEM>
      	m_bEst_Active				est un booléen				<mapping=Est_Active>
      	m_bEst_supprime				est un booléen				<mapping=Est_supprime>
      	m_sCommentaire				est une chaîne				<mapping=Commentaire>
      	m_bDonnees_Transmissibles	est un booléen				<mapping=Donnees_Transmissibles>
      	m_bImage_Reseaux				est un booléen				<mapping=Image_Reseaux>
      	m_bLPD_acceptee				est un booléen				<mapping=LPD_acceptee>
      	m_dDate_MAJ					est une date				<mapping=Date_MAJ>
      	m_dDate_Modification		est une date				<mapping=Date_Modification>
      	<FIN><§rad:1§>
      <§rad:1§>
      	m_sRecherche			est une chaine<§rad:1§>
      	mtab_instruments		est un tableau de CL_Instrument<§rad:1§>
      	m_bMultipleInstruments	est un booléen<§rad:1§>
      <§rad:1§>
      FIN<§rad:1§>
      <§rad:1§>
     type : 131072
  procedures :
   -
     name : Constructeur
     procedure_id : 1362620572731444740
     type_code : 27
     code : |1-
      PROCEDURE Constructeur()<§rad:1§>
      m_sfichierBD = "PERSONNE"<§rad:1§>
      <§rad:1§>
      m_bEst_Active = Vrai<§rad:1§>
     type : 589824
   -
     name : Constructeur
     procedure_id : 1362620572731444740
     type_code : 27
     code : |1-
      procédure Constructeur(vn_id est un entier sur 8 octets)<§rad:1§>
      <§rad:1§>
      m_sfichierBD = "PERSONNE"<§rad:1§>
      <§rad:1§>
      SI HLitRecherchePremier(Personne,id,vn_id) ALORS<§rad:1§>
      	FichierVersMémoire(Objet,Personne)<§rad:1§>
      	:mtab_instruments = Liste_Instruments_Personne(vn_id)<§rad:1§>
      FIN<§rad:1§>
     type : 589825
   -
     name : Destructeur
     procedure_id : 1362620572731510276
     type_code : 28
     code : |1-
      PROCEDURE Destructeur()<§rad:1§>
     type : 655360
   -
     name : Ajouter_Instrument
     procedure_id : 1362620572731575812
     type_code : 12
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure><§rad:1§>
      // Syntaxe :<§rad:1§>
      //Ajouter_Instrument (<vn_id>)<§rad:1§>
      //<§rad:1§>
      // Paramètres :<§rad:1§>
      // 	vn_id : <indiquez ici le rôle de vn_id><§rad:1§>
      // Valeur de retour :<§rad:1§>
      // 	Aucune<§rad:1§>
      //<§rad:1§>
      // Exemple :<§rad:1§>
      // <Indiquez ici un exemple d'utilisation><§rad:1§>
      //<§rad:1§>
      procédure Ajouter_Instrument(vn_id)<§rad:1§>
      <§rad:1§>
      vcl_instrument est une CL_Instrument<§rad:1§>
      <§rad:1§>
      SI HLitRecherchePremier(Instrument,ID,vn_id) ALORS <§rad:1§>
      	FichierVersMémoire(vcl_instrument,Instrument)<§rad:1§>
      	mtab_instruments.AjouteLigne(vcl_instrument)<§rad:1§>
      FIN<§rad:1§>
     type : 458752
   -
     name : Charger_Instruments_Joues
     procedure_id : 1364852126098211566
     type_code : 12
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure><§rad:1§>
      // Syntaxe :<§rad:1§>
      // Charger_Instruments_Joues ()<§rad:1§>
      //<§rad:1§>
      // Paramètres :<§rad:1§>
      //	Aucun<§rad:1§>
      // Valeur de retour :<§rad:1§>
      // 	Aucune<§rad:1§>
      //<§rad:1§>
      // Exemple :<§rad:1§>
      // <Indiquez ici un exemple d'utilisation><§rad:1§>
      //<§rad:1§>
      procédure Charger_Instruments_Joues()<§rad:1§>
      <§rad:1§>
      :mtab_instruments = Liste_Instruments_Personne(m_ID)<§rad:1§>
     type : 458752
   -
     name : Sauver
     procedure_id : 1367829101088454903
     type_code : 12
     code : |1-
      // Redéfinition de la méthode CL_Gestion.Sauver<§rad:1§>
      PROCÉDURE PUBLIQUE Sauver() <§rad:1§>
      <§rad:1§>
      vcl_persInstr	est une CL_Personne_Instrument<§rad:1§>
      vb_creation		est un booléen<§rad:1§>
      <§rad:1§>
      vb_creation = m_ID = 0<§rad:1§>
      Ancêtre.Sauver()<§rad:1§>
      <§rad:1§>
      Si vb_creation ALORS<§rad:1§>
      	pour i = 1 A mtab_instruments..Occurrence<§rad:1§>
      		vcl_persInstr.m_IDInstrument	= mtab_instruments[i].m_ID<§rad:1§>
      		vcl_persInstr.m_IDPersonne		= m_Id<§rad:1§>
      		vcl_persInstr.Sauver_Personne_Instrument(vrai)<§rad:1§>
      	FIN<§rad:1§>
      FIN<§rad:1§>
     type : 458752
   -
     name : Supprimer
     procedure_id : 1367836527090343170
     type_code : 12
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure><§rad:1§>
      // Syntaxe :<§rad:1§>
      // Supprimer ()<§rad:1§>
      //<§rad:1§>
      // Paramètres :<§rad:1§>
      //	Aucun<§rad:1§>
      // Valeur de retour :<§rad:1§>
      // 	Aucune<§rad:1§>
      //<§rad:1§>
      // Exemple :<§rad:1§>
      // <Indiquez ici un exemple d'utilisation><§rad:1§>
      //<§rad:1§>
      procédure Supprimer()<§rad:1§>
      <§rad:1§>
      //On ne supprime pas toutes les dépendances, on marque juste l'enregistrement comme supprimé
      :m_bEst_supprime = Vrai
      :m_bEst_Active = Faux
      :m_dDate_Modification = DateDuJour()
      :Sauver()
     type : 458752
