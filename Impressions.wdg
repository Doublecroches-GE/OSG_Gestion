   -
     name : Imprimer_Participants
     procedure_id : 1828722367984308586
     type_code : 15
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //!
      procédure Imprimer_Participants()
      
      gcl_Impression.Charger_EffectifEntier()
      gcl_Impression.m_tab_Personnes.Trie(ttMembre,"m_sNom"		)
      
      
      iDestination(iVisualisateur)
      iImprimeEtat(ETAT_ParticipantsSession, gcl_Impression, Vrai)
     type : 458752
