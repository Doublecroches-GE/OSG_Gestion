   -
     name : Imprimer_Effectif
     procedure_id : 1757410096871018094
     type_code : 15
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // Imprimer_Effectif ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure Imprimer_Effectif()
      
      gcl_Impression.Charger_EffectifEntier()
      
      iDestination(iVisualisateur)
      iImprimeEtat(ETAT_Effectif, gcl_Impression, vrai)
     type : 458752
   -
     name : Imprimer_Cordes
     procedure_id : 1757490155005017236
     type_code : 15
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // Imprimer_Cordes ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure Imprimer_Cordes()
      
      vcl_impression	est une CL_Impression
      vn_pupitre		est un entier
      
      gcl_Impression.Charger_Cordes()
      
      pour i = 1 A TableauOccurrence(gcl_Impression.m_tab_Personnes)
      	SI gcl_Impression.m_tab_Personnes[i].m_nIDPupitre <> vn_pupitre ALORS
      		SI TableauOccurrence(vcl_impression.m_tab_Personnes) > 0 ALORS
      			iDestination(iVisualisateur)
      			iImprimeEtat(ETAT_ParPupitre, vcl_impression)
      		FIN
      		VariableRAZ(vcl_impression)
      	FIN
      	vcl_impression.m_tab_Personnes.Ajoute(gcl_Impression.m_tab_Personnes[i])
      	vn_pupitre = gcl_Impression.m_tab_Personnes[i].m_nIDPupitre
      FIN
      SI TableauOccurrence(vcl_impression.m_tab_Personnes) > 0 ALORS
      	iDestination(iVisualisateur)
      	iImprimeEtat(ETAT_ParPupitre, vcl_impression)
      FIN
     type : 458752
   -
